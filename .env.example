# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Anthropic (required) ---
# API billing only. Do NOT use a claude.ai login token here.
ANTHROPIC_API_KEY=sk-ant-...

# --- Reddit "script" app (required, free) ---
# Create one at https://www.reddit.com/prefs/apps -> "create app" -> type "script".
# client_id is the string under the app name; client_secret is the "secret" field.
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
# A reddit username/password are only needed for actions that require a logged-in
# user. This agent is READ-ONLY, so app-only (client credentials) auth is enough
# and these can be left blank. Fill them only if you hit auth issues.
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Email ingest (F5Bot alerts via IMAP) — the automated path ---
# Use a DEDICATED free Gmail (not your corporate mailbox). Turn on 2-Step
# Verification, then create an App Password (Google Account -> Security -> App
# passwords) and paste the 16-char value below. Point F5Bot to deliver alerts to
# this Gmail. The job reads it via IMAP; your corporate inbox stays untouched.
IMAP_USER=your-alert-inbox@gmail.com
IMAP_PASSWORD=your-16-char-app-password

# --- Store (optional) ---
# Leave both blank to use local SQLite (default, runs out of the box at
# ./stg_monitor.db). Set both to use Supabase instead — the code auto-detects
# them and switches with no other changes.
SUPABASE_URL=
SUPABASE_KEY=
